generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
  id String @id @default(uuid())
  username String @unique
  email String @unique
  password String
  phoneNo String?
  role UserRole?
  name String?
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Location {
  id String @id @default(uuid())
  lat Float
  long Float
  emergencyId String
  alert Emergency @relation(fields: [emergencyId],references: [id])
}

model Emergency{
  id String @id @default(uuid())
  type HazardType
  reportedBy String
  status StatusReport
  assignedTo UserRole
  timeStamp DateTime @default(now())
  statusUpdatedAt DateTime? @updatedAt
  description String?
  priority PriorityLevel
  location Location[]
}

enum UserRole {
  CIVILIAN
  POLICE
  FIRE
  MEDICAL
}

enum HazardType {
  FIRE
  CRIME
  ACCIDENT
  MEDICAL
  OTHER
}

enum StatusReport {
  REPORTED
  IN_PROCESS
  RESOLVED
}

enum PriorityLevel {
LOW
MEDIUM
HIGH
}